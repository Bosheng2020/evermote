# Copy this file to .env.local. Never commit real credentials.

# Required on a non-Vercel host when agent/agent.ts uses a string model ID
# through Vercel AI Gateway. Vercel deployments can use project OIDC instead.
AI_GATEWAY_API_KEY=

# Vercel production file memory. Prefer an attached private Blob store with
# project OIDC; `eve integration setup file-memory` provisions these bindings.
# EVE_MEMORY_BLOB_STORE_ID=
# EVE_MEMORY_BLOB_READ_WRITE_TOKEN=

# Optional self-hosted server settings.
PORT=3000

# Required for correct production canonical, Open Graph, robots, sitemap, and
# structured-data URLs on a self-hosted deployment. Vercel supplies a stable
# production hostname automatically, but an explicit canonical URL wins.
# NEXT_PUBLIC_SITE_URL=https://evermote.example.com

# Optional public verification token from Google Search Console. This value is
# intentionally rendered in page metadata and must never contain a secret.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional when a reverse proxy publishes the eve service below a path prefix.
# EVE_PUBLIC_ROUTE_PREFIX=/agent

# Optional when Next.js should proxy to an independently supervised eve service.
# EVE_NEXT_PRODUCTION_ORIGIN=https://agent.example.com

# Optional for local tooling that connects to a protected Vercel deployment.
# VERCEL_AUTOMATION_BYPASS_SECRET=
