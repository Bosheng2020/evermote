{
  "name": "evermote",
  "version": "0.1.0",
  "private": true,
  "description": "An experimental, governed open-source personal-agent starter built with eve.",
  "license": "MIT",
  "homepage": "https://github.com/Bosheng2020/evermote#readme",
  "bugs": {
    "url": "https://github.com/Bosheng2020/evermote/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bosheng2020/evermote.git"
  },
  "keywords": [
    "ai-agent",
    "personal-agent",
    "human-in-the-loop",
    "scoped-memory",
    "eve",
    "nextjs",
    "self-hosted"
  ],
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "build:agent": "eve build",
    "build:web": "next build apps/web --webpack",
    "ci": "pnpm typecheck && pnpm build:agent && pnpm build:web",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "dev:web": "next dev apps/web",
    "eval": "eve eval",
    "start": "eve start",
    "typecheck": "pnpm typecheck:agent && pnpm typecheck:web",
    "typecheck:agent": "tsc --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@shadcn/react": "0.3.1",
    "@shikijs/core": "3.23.0",
    "@shikijs/engine-javascript": "3.23.0",
    "@shikijs/engine-oniguruma": "3.23.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "2.0.0",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/connect": "2.5.2",
    "ai": "^7.0.137",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eve": "^0.81.1",
    "lucide-react": "1.16.0",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "next": "16.3.6",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "3.23.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "~26.6.5",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "just-bash": "3.1.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
